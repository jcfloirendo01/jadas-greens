NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Resend email (https://resend.com) - add your API key to enable email order alerts.
# Add more than one recipient with commas.
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=Jada's Greens <orders@your-verified-domain.com>
RESEND_ORDER_TO_EMAILS=owner@example.com,second@example.com

# Gmail SMTP fallback. Create an app password in your Google Account, not your normal Gmail password.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_FROM=Jada's Greens <your-gmail-address@gmail.com>
